{
  "name": "@0xdeafcafe/skills-evals",
  "version": "0.1.0",
  "private": true,
  "description": "Behavioral scenarios for the intent-led v2 workflow and archived v1 regression utilities.",
  "type": "module",
  "scripts": {
    "upload-dataset": "node --env-file-if-exists=../.env runners/upload-dataset.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "legacy:tier1": "node runners/run-tier1.ts",
    "legacy:tier2": "node --env-file-if-exists=../.env runners/run-pipeline.ts",
    "legacy:tier3": "node --env-file-if-exists=../.env runners/run-tier3.ts",
    "legacy:scenarios": "node --env-file-if-exists=../.env node_modules/vitest/vitest.mjs run --config scenarios/vitest.config.ts",
    "scenarios:v2": "node node_modules/vitest/vitest.mjs run --config v2/scenarios/vitest.config.ts",
    "scenarios:v2:list": "node node_modules/vitest/vitest.mjs list --config v2/scenarios/vitest.config.ts",
    "test:v2": "python3 -B -m unittest discover -s v2 -p test_*.py -v",
    "test:fixtures": "vitest run --config v2/vitest.config.ts",
    "fixtures:capture": "SKILLS_EVAL_RECORD=1 node node_modules/vitest/vitest.mjs run --config v2/scenarios/vitest.config.ts",
    "format": "prettier --write \"**/*.ts\"",
    "format:check": "prettier --check \"**/*.ts\""
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "prettier": "3.8.1",
    "typescript": "^5.5.0",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.81",
    "@anthropic-ai/claude-agent-sdk": "^0.3.169",
    "@langwatch/scenario": "^1.6.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/context-async-hooks": "^2.7.1",
    "@opentelemetry/sdk-node": "^0.218.0",
    "ai": "6.0.198",
    "ajv": "^8.17.0",
    "ajv-formats": "^3.0.0",
    "langwatch": "^0.32.0",
    "zod": "4.4.3"
  },
  "packageManager": "pnpm@10.15.1"
}
